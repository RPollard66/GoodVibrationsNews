[Unit]
Description=Good Vibrations News web app
After=network.target

[Service]
Type=simple
User=beck
Group=beck
WorkingDirectory=/home/beck/GoodVibrationsNews
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
